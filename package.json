{
    "name": "backranq",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": "24.x"
    },
    "scripts": {
        "dev": "next dev",
        "prebuild": "prisma generate && node scripts/copy-stockfish-browser.mjs && node scripts/build-maia-browser.mjs",
        "build": "next build",
        "vercel-build": "prisma generate && node scripts/copy-stockfish-browser.mjs && node scripts/build-maia-browser.mjs && next build",
        "db:migrate:deploy": "node scripts/migrate-with-timeout.mjs",
        "check:db-contract": "node scripts/ci/verify-database-contract.mjs",
        "check:schema-shape": "node scripts/ci/verify-prisma-schema-shape.mjs",
        "check:queue-runtime-bundle": "node scripts/ci/verify-queue-runtime-bundle.mjs",
        "check:queue-runtime-callback": "node scripts/ci/smoke-queue-runtime-callback.mjs",
        "start": "next start",
        "lint": "eslint",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:e2e": "node scripts/run-e2e.mjs",
        "test:e2e:headed": "node scripts/run-e2e.mjs --headed",
        "test:e2e:ui": "node scripts/run-e2e.mjs --ui",
        "test:e2e:coach-offline": "node scripts/run-e2e.mjs --config=playwright.offline.config.ts",
        "test:e2e:coach-offline:built": "node scripts/run-e2e.mjs --skip-build --config=playwright.offline.config.ts",
        "test:e2e:maia-model": "RUN_MAIA_BROWSER_SMOKE=1 node scripts/run-e2e.mjs --config=playwright.offline.config.ts tests/e2e/coach-maia-model.live.spec.ts",
        "test:maia-model": "RUN_MAIA_MODEL_SMOKE=1 vitest run tests/lib/coach-maia-model.live.test.ts",
        "test:e2e:install": "playwright install chromium",
        "check:runtime": "node scripts/check-runtime-readiness.mjs",
        "check:stripe": "node scripts/smoke-stripe-billing.mjs",
        "check:ledger": "node scripts/reconcile-credit-ledger.mjs",
        "admin:grant": "node scripts/grant-admin.mjs",
        "smoke:auth-session": "node scripts/seed-local-auth-session.mjs",
        "smoke:stockfish-browser": "node scripts/smoke-stockfish-browser.mjs",
        "benchmark:coach-engine": "node scripts/benchmark-coach-engine.mjs",
        "quality:extract:refresh": "node scripts/run-extraction-quality-lab.mjs refresh",
        "quality:extract:smoke": "node scripts/run-extraction-quality-lab.mjs smoke",
        "quality:extract": "node scripts/run-extraction-quality-lab.mjs full",
        "quality:extract:confirmation": "node scripts/run-extraction-quality-lab.mjs confirmation",
        "load:analysis-queue": "node scripts/simulate-analysis-queue-load.mjs",
        "audit:prod": "pnpm audit --prod --audit-level=high",
        "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
        "postinstall": "prisma generate && node scripts/copy-stockfish-browser.mjs && node scripts/build-maia-browser.mjs"
    },
    "dependencies": {
        "@auth/prisma-adapter": "^2.11.3",
        "@prisma/client": "^6.19.3",
        "@radix-ui/react-avatar": "^1.1.11",
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@radix-ui/react-select": "^2.2.6",
        "@radix-ui/react-separator": "^1.1.8",
        "@radix-ui/react-slot": "^1.2.4",
        "@radix-ui/react-tabs": "^1.1.13",
        "@radix-ui/react-tooltip": "^1.2.8",
        "@supabase/ssr": "^0.8.0",
        "@supabase/supabase-js": "^2.88.0",
        "@vercel/queue": "^0.3.1",
        "chess.js": "^1.4.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^0.542.0",
        "next": "16.2.11",
        "next-auth": "5.0.0-beta.32",
        "onnxruntime-web": "1.27.0",
        "react": "19.2.1",
        "react-chessboard": "^5.8.6",
        "react-dom": "19.2.1",
        "react-email": "^6.9.1",
        "sonner": "^2.0.7",
        "stockfish": "18.0.8",
        "stripe": "^22.3.0",
        "tailwind-merge": "^3.4.0",
        "web-push": "^3.6.7"
    },
    "devDependencies": {
        "@playwright/test": "1.61.1",
        "@serwist/turbopack": "9.5.12",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@types/web-push": "^3.6.4",
        "autoprefixer": "^10.4.23",
        "babel-plugin-react-compiler": "1.0.0",
        "esbuild": "^0.28.1",
        "eslint": "^9",
        "eslint-config-next": "16.2.11",
        "postcss": "^8.5.6",
        "prisma": "^6.19.3",
        "serwist": "9.5.12",
        "tailwindcss": "^3.4.19",
        "tailwindcss-animate": "^1.0.7",
        "typescript": "^5",
        "vitest": "^4.1.9"
    },
    "pnpm": {
        "overrides": {
            "@babel/core": "7.29.6",
            "defu": "6.1.5",
            "minimatch@10.2.5>brace-expansion": "5.0.9",
            "nanoid": "3.3.18",
            "postcss": "8.5.23",
            "sharp": "0.35.0",
            "ws": "8.21.0"
        }
    },
    "packageManager": "pnpm@10.24.0"
}
