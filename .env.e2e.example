# Optional: use only an isolated, disposable database or Supabase development branch.
E2E_DATABASE_URL=postgresql://postgres.devbranchref:password@aws-0-region.pooler.supabase.com:6543/postgres
E2E_DIRECT_URL=postgresql://postgres:password@db.devbranchref.supabase.co:5432/postgres

# All five confirmations are required before migrations or fixture writes may
# reach external hosts. List the exact host[:port] values from both URLs.
BACKRANQ_E2E_USE_EXTERNAL_DATABASE=true
BACKRANQ_E2E_DATABASE_MODE=external
BACKRANQ_E2E_ALLOW_REMOTE=true
BACKRANQ_E2E_CONFIRM_DATA_WRITES=DELETE_ONLY_BACKRANQ_E2E_FIXTURES
BACKRANQ_E2E_CONFIRM_DATABASE_HOSTS=aws-0-region.pooler.supabase.com:6543,db.devbranchref.supabase.co:5432
