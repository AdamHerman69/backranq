model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String?   @unique
  emailVerified DateTime?
  name          String?
  image         String?
  preferences   Json      @default(dbgenerated("'{}'::jsonb"))
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  games                       AnalyzedGame[]
  trainingMoments             TrainingMoment[]
  trainingAttempts            TrainingAttempt[]
  practiceExposures           PracticeExposure[]
  attemptStatusEvents         TrainingAttemptStatusEvent[]
  practiceReviewStates        PracticeReviewState[]
  practiceReviewEvents        PracticeReviewEvent[]
  practiceDueSweepUsers       PracticeDueSweepUser[]
  progressAnalyticsEvents     ProgressAnalyticsEvent[]
  progressAnalyticsRateBucket ProgressAnalyticsRateBucket?
  providerSyncStates          ProviderSyncState[]
  chessAccountConnections     ChessAccountConnection[]
  historyImportQuotas         HistoryImportQuota[]
  syncJobs                    SyncJob[]
  analysisJobs                AnalysisJob[]
  analysisRuns                AnalysisRun[]
  creditLedgerEntries         CreditLedgerEntry[]
  billingAccount              BillingAccount?
  planGrants                  PlanGrant[]                  @relation("PlanGrantRecipient")
  grantedPlanGrants           PlanGrant[]                  @relation("PlanGrantGranter")
  premiumInvitationsSent      PremiumInvitation[]          @relation("PremiumInvitationInviter")
  premiumInvitationsAccepted  PremiumInvitation[]          @relation("PremiumInvitationRecipient")
  notifications               Notification[]
  notificationPreference      NotificationPreference?
  notificationDeliveries      NotificationDelivery[]
  pushSubscriptions           PushSubscription[]
  adminMembership             AdminMembership?
  onboardingAnalyticsEvents   OnboardingAnalyticsEvent[]

  // NextAuth (Auth.js) relations
  accounts Account[]
  sessions Session[]
}

/// A durable provider account selected for importing a user's games. This is
/// deliberately separate from Auth.js Account: signing in proves application
/// identity, while this row defines the game source that sync is allowed to use.
model ChessAccountConnection {
  id                 String           @id @default(uuid()) @db.Uuid
  userId             String           @db.Uuid
  provider           SyncProvider
  providerAccountId  String?
  username           String
  usernameNormalized String
  origin             ConnectionOrigin
  verifiedAt         DateTime         @default(now())
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([provider, usernameNormalized])
}

model AdminMembership {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @unique @db.Uuid
  role      AdminRole @default(EDITOR)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditLogs        AdminAuditLog[]
  createdOverrides MasterAdminOverride[] @relation("MasterOverrideCreatedBy")
  revokedOverrides MasterAdminOverride[] @relation("MasterOverrideRevokedBy")

  @@index([active, role])
}

model AdminAuditLog {
  id                String   @id @default(uuid()) @db.Uuid
  adminMembershipId String   @db.Uuid
  idempotencyKey    String?  @unique
  action            String
  targetType        String
  targetId          String?
  requestId         String?
  reason            String?  @db.Text
  metadata          Json     @default(dbgenerated("'{}'::jsonb"))
  createdAt         DateTime @default(now())

  adminMembership AdminMembership @relation(fields: [adminMembershipId], references: [id], onDelete: Restrict)

  @@index([adminMembershipId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([requestId])
}

model NotificationPreference {
  id                           String                      @id @default(uuid()) @db.Uuid
  userId                       String                      @unique @db.Uuid
  emailPracticeReady           Boolean                     @default(true)
  emailAnalysisFailed          Boolean                     @default(false)
  emailSyncSummary             Boolean                     @default(false)
  emailBilling                 Boolean                     @default(true)
  emailWeeklyProgress          Boolean                     @default(false)
  emailProductNews             Boolean                     @default(false)
  pushEnabled                  Boolean                     @default(false)
  syncDigestFrequency          NotificationDigestFrequency @default(OFF)
  timezone                     String                      @default("UTC")
  digestHour                   Int                         @default(9)
  productNewsConsentedAt       DateTime?
  optionalEmailsUnsubscribedAt DateTime?
  emailSuppressedAt            DateTime?
  createdAt                    DateTime                    @default(now())
  updatedAt                    DateTime                    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([emailWeeklyProgress, timezone, digestHour])
  @@index([emailProductNews, productNewsConsentedAt])
}

model Notification {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  type           NotificationType
  title          String
  body           String           @db.Text
  href           String?
  metadata       Json             @default(dbgenerated("'{}'::jsonb"))
  itemCount      Int              @default(1)
  secondaryCount Int              @default(0)
  dedupeKey      String           @unique
  readAt         DateTime?
  archivedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId, readAt, createdAt])
  @@index([userId, type, createdAt])
  @@index([createdAt])
}

model NotificationDelivery {
  id                String                     @id @default(uuid()) @db.Uuid
  notificationId    String                     @db.Uuid
  userId            String                     @db.Uuid
  channel           NotificationChannel
  status            NotificationDeliveryStatus @default(PENDING)
  dispatchPriority  Int                        @default(1)
  recipient         String?
  scheduledFor      DateTime                   @default(now())
  lockedUntil       DateTime?
  dispatchToken     String?                    @unique @db.Uuid
  attempts          Int                        @default(0)
  providerMessageId String?                    @unique
  lastError         String?                    @db.Text
  sentAt            DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([status, scheduledFor, id])
  @@index([userId, channel, createdAt])
  @@index([status, lockedUntil, id])
  @@index([status, channel, dispatchPriority, scheduledFor, createdAt, id], map: "NotificationDelivery_dispatch_stream_idx")
  @@index([status, channel, scheduledFor, createdAt, id], map: "NotificationDelivery_pending_channel_schedule_idx")
}

/// One atomic counter row per SMTP2GO UTC accounting day. Both notification
/// delivery and Premium invitations reserve from this shared budget.
model EmailProviderDay {
  day                      DateTime @id @db.Date
  reservedCount            Int      @default(0)
  nonPriorityReservedCount Int      @default(0)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @default(now()) @updatedAt

  reservations EmailSendReservation[]
}

/// Durable evidence around the irreversible provider handoff. The nullable
/// Practice window key is unique, so two delivery workers cannot both own the
/// same user's local calendar-day send window.
model EmailSendReservation {
  id                String                     @id @default(uuid()) @db.Uuid
  providerDay       DateTime                   @db.Date
  ownerType         EmailSendOwnerType
  ownerId           String                     @db.Uuid
  ownerToken        String                     @unique @db.Uuid
  /// Stable across worker/lease-token retries. A partial unique index in the
  /// migration allows a replacement only after the prior row is RELEASED.
  logicalAttemptKey String
  priority          Boolean                    @default(false)
  practiceWindowKey String?                    @unique
  status            EmailSendReservationStatus @default(RESERVED)
  leaseUntil        DateTime
  providerMessageId String?
  lastError         String?                    @db.Text
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @default(now()) @updatedAt

  budget EmailProviderDay @relation(fields: [providerDay], references: [day], onDelete: Restrict)

  @@index([ownerType, ownerId, createdAt])
  @@index([status, leaseUntil, id])
}

model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  endpoint  String   @unique @db.Text
  p256dh    String   @db.Text
  auth      String   @db.Text
  userAgent String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BillingAccount {
  id                           String             @id @default(uuid()) @db.Uuid
  userId                       String             @unique @db.Uuid
  plan                         BillingPlan        @default(FREE)
  planSource                   BillingPlanSource  @default(FREE)
  stripePlan                   BillingPlan        @default(FREE)
  stripeCustomerId             String?            @unique
  stripeSubscriptionId         String?            @unique
  stripeSubscriptionStatus     String?
  stripePriceId                String?
  stripeCurrentPeriodStart     DateTime?
  stripeCurrentPeriodEnd       DateTime?
  stripeLastEventCreatedAt     DateTime?
  stripeLastEventId            String?
  stripeCheckoutReservationId  String?            @unique
  stripeCheckoutSessionId      String?            @unique
  stripeCheckoutPlan           BillingPlan?
  stripeCheckoutExpiresAt      DateTime?
  stripeCheckoutFencePlan      BillingPlan?
  stripeCheckoutFenceSource    BillingPlanSource?
  serverCreditsBalance         Int                @default(100)
  monthlyServerCreditsUsed     Int                @default(0)
  serverCreditsPeriodStart     DateTime           @default(now())
  serverCreditsRenewAt         DateTime           @default(dbgenerated("(now() + '1 mon'::interval)"))
  monthlyServerCreditsLimit    Int                @default(100)
  autoAnalysisMonthlyGameLimit Int                @default(50)
  autoAnalysisDailyGameLimit   Int                @default(10)
  stopWhenCreditsBelow         Int                @default(0)
  createdAt                    DateTime           @default(now())
  updatedAt                    DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([plan])
  @@index([planSource])
  @@index([stripePlan])
  @@index([stripePriceId])
  @@index([stripeSubscriptionStatus])
  @@index([serverCreditsRenewAt])
}

model PlanGrant {
  id           String          @id @default(uuid()) @db.Uuid
  userId       String          @db.Uuid
  plan         BillingPlan
  source       PlanGrantSource @default(ADMIN_INVITATION)
  invitationId String?         @unique @db.Uuid
  grantedById  String?         @db.Uuid
  startsAt     DateTime        @default(now())
  expiresAt    DateTime?
  revokedAt    DateTime?
  note         String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user       User               @relation("PlanGrantRecipient", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy  User?              @relation("PlanGrantGranter", fields: [grantedById], references: [id], onDelete: SetNull)
  invitation PremiumInvitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt, startsAt, expiresAt])
  @@index([grantedById])
}

model PremiumInvitation {
  id                    String                          @id @default(uuid()) @db.Uuid
  email                 String
  emailNormalized       String
  activeKey             String?                         @unique
  tokenHash             String                          @unique
  plan                  BillingPlan                     @default(PRO)
  invitedById           String?                         @db.Uuid
  acceptedById          String?                         @db.Uuid
  expiresAt             DateTime
  acceptedAt            DateTime?
  revokedAt             DateTime?
  deliveryGeneration    Int                             @default(1)
  deliveryStatus        PremiumInvitationDeliveryStatus @default(PENDING)
  deliveryAttempts      Int                             @default(0)
  deliverySendAttemptId String                          @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deliveryLeaseToken    String?
  deliveryLeaseUntil    DateTime?
  lastDeliveryAttemptAt DateTime?
  emailSentAt           DateTime?
  providerEmailId       String?
  lastEmailError        String?
  createdAt             DateTime                        @default(now())
  updatedAt             DateTime                        @updatedAt

  invitedBy  User?      @relation("PremiumInvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedBy User?      @relation("PremiumInvitationRecipient", fields: [acceptedById], references: [id], onDelete: SetNull)
  planGrant  PlanGrant?

  @@index([emailNormalized, createdAt])
  @@index([expiresAt])
  @@index([invitedById])
  @@index([acceptedById])
  @@index([deliveryStatus, deliveryLeaseUntil])
}

model StripeWebhookEvent {
  id              String    @id
  type            String
  status          String    @default("PROCESSING")
  attempts        Int       @default(1)
  lastError       String?   @db.Text
  processedAt     DateTime?
  processingToken String?
  processingUntil DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, updatedAt])
  @@index([status, processingUntil])
  @@index([type, createdAt])
}

model AnalyzedGame {
  id                          String       @id @default(uuid()) @db.Uuid
  userId                      String       @db.Uuid
  provider                    GameSource
  externalId                  String
  url                         String?
  pgn                         String       @db.Text
  sourcePgnHash               String
  sourceUsername              String
  sourceAccountId             String?
  userSide                    GameUserSide
  playedAt                    DateTime
  timeClass                   TimeClass
  timeControlRaw              String?
  timeControlInitialSeconds   Int?
  timeControlIncrementSeconds Int?
  rated                       Boolean?
  result                      String?
  termination                 String?
  whiteName                   String
  whiteRating                 Int?
  blackName                   String
  blackRating                 Int?
  openingEco                  String?
  openingName                 String?
  openingVariation            String?
  analysis                    Json
  analyzedAt                  DateTime?
  currentAnalysisRunId        String?      @db.Uuid
  currentAnalysisValid        Boolean      @default(false)
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt

  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainingMoments     TrainingMoment[]
  analysisJobs        AnalysisJob[]
  analysisRuns        AnalysisRun[]       @relation("GameAnalysisRuns")
  currentAnalysisRun  AnalysisRun?        @relation("CurrentAnalysisRun", fields: [currentAnalysisRunId], references: [id], onDelete: SetNull)
  creditLedgerEntries CreditLedgerEntry[]

  @@unique([userId, provider, externalId])
  @@unique([id, userId])
  @@index([userId])
  @@index([userId, playedAt, provider, timeClass])
  @@index([userId, analyzedAt])
  @@index([userId, currentAnalysisValid, playedAt])
  @@index([userId, sourcePgnHash])
  @@index([provider, externalId])
  @@index([currentAnalysisRunId])
}

model ProviderSyncState {
  id                         String       @id @default(uuid()) @db.Uuid
  userId                     String       @db.Uuid
  provider                   SyncProvider
  providerUsernameNormalized String?
  importPolicyHash           String?
  lastSyncedPlayedAt         DateTime?
  cursorSincePlayedAt        DateTime?
  cursorUntilPlayedAt        DateTime?
  cursorWindowEnd            DateTime?
  lastAttemptAt              DateTime?
  lastSuccessAt              DateTime?
  lastError                  String?      @db.Text
  etag                       String?      @db.Text
  lastModified               String?      @db.Text
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([lastAttemptAt])
}

model HistoryImportQuota {
  id                 String       @id @default(uuid()) @db.Uuid
  userId             String       @db.Uuid
  provider           SyncProvider
  usernameNormalized String
  createdCount       Int          @default(0)
  fetchLeaseToken    String?
  fetchLeaseUntil    DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, usernameNormalized])
  @@index([userId, provider])
}

model SyncJob {
  id                  String        @id @default(uuid()) @db.Uuid
  userId              String        @db.Uuid
  provider            SyncProvider
  status              SyncJobStatus @default(QUEUED)
  scheduledFor        DateTime      @default(now())
  lockedUntil         DateTime?
  leaseToken          String?
  attempts            Int           @default(0)
  lastError           String?       @db.Text
  startedAt           DateTime?
  completedAt         DateTime?
  fetchedCount        Int           @default(0)
  savedCount          Int           @default(0)
  createdCount        Int           @default(0)
  updatedCount        Int           @default(0)
  queuedAnalysisCount Int           @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, provider, status])
  @@index([status, scheduledFor])
  @@index([lockedUntil])
}

model AnalysisJob {
  id               String            @id @default(uuid()) @db.Uuid
  userId           String            @db.Uuid
  gameId           String            @db.Uuid
  analysisRunId    String            @db.Uuid
  status           AnalysisJobStatus @default(QUEUED)
  priority         Int               @default(0)
  attempts         Int               @default(0)
  scheduledFor     DateTime?
  lockedAt         DateTime?
  lockedUntil      DateTime?
  lastDispatchedAt DateTime?
  dispatchedCount  Int               @default(0)
  weight           Int               @default(0)
  startedAt        DateTime?
  completedAt      DateTime?
  lastError        String?           @db.Text
  queuedReason     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  game                AnalyzedGame        @relation(fields: [gameId, userId], references: [id, userId], onDelete: Cascade)
  analysisRun         AnalysisRun         @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  creditLedgerEntries CreditLedgerEntry[]

  @@unique([gameId])
  @@index([userId, status])
  @@index([analysisRunId])
  @@index([status, priority, createdAt])
  @@index([status, scheduledFor, priority, createdAt])
  @@index([lockedAt])
  @@index([lockedUntil])
  @@index([lastDispatchedAt])
}

/// Durable serverless-safe operational counters. These counters are deliberately
/// separate from AnalysisJob so rejected stale deliveries cannot mutate the
/// currently fenced job generation.
model AnalysisOpsCounter {
  key       String   @id
  value     BigInt   @default(0)
  updatedAt DateTime @default(now()) @updatedAt
}

model AnalysisRun {
  id              String                @id @default(uuid()) @db.Uuid
  userId          String                @db.Uuid
  gameId          String                @db.Uuid
  executionMode   AnalysisExecutionMode
  analysisQuality AnalysisQuality
  creditCost      Int
  status          AnalysisRunStatus     @default(QUEUED)
  queuedReason    String?
  engineName      String?
  engineVersion   String?
  engineSource    String?
  engineFlavor    String?
  engineEvalFile  String?
  engineOptions   Json                  @default(dbgenerated("'{}'::jsonb"))
  appVersion      String?
  inputPgnHash    String
  configSnapshot  Json                  @default(dbgenerated("'{}'::jsonb"))
  configHash      String
  startedAt       DateTime?
  completedAt     DateTime?
  durationMs      Int?
  consumedCredits Int?
  lastError       String?               @db.Text
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  user                       User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  game                       AnalyzedGame                @relation("GameAnalysisRuns", fields: [gameId, userId], references: [id, userId], onDelete: Cascade)
  currentForGames            AnalyzedGame[]              @relation("CurrentAnalysisRun")
  solutionRevisions          SolutionRevision[]
  trainingMomentObservations TrainingMomentObservation[]
  analysisJobs               AnalysisJob[]
  creditLedgerEntries        CreditLedgerEntry[]

  @@unique([id, gameId, userId])
  @@index([userId, status])
  @@index([gameId, createdAt])
  @@index([executionMode, status])
  @@index([configHash])
  @@index([inputPgnHash])
}

model CreditLedgerEntry {
  id                 String                 @id @default(uuid()) @db.Uuid
  userId             String                 @db.Uuid
  analysisJobId      String?                @db.Uuid
  analysisRunId      String?                @db.Uuid
  gameId             String?                @db.Uuid
  type               CreditLedgerEntryType
  scope              CreditLedgerEntryScope @default(RESERVATION)
  billingPeriodStart DateTime
  credits            Int
  idempotencyKey     String                 @unique
  reason             String?
  metadata           Json                   @default(dbgenerated("'{}'::jsonb"))
  createdAt          DateTime               @default(now())

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysisJob AnalysisJob?  @relation(fields: [analysisJobId], references: [id], onDelete: SetNull)
  analysisRun AnalysisRun?  @relation(fields: [analysisRunId], references: [id], onDelete: SetNull)
  game        AnalyzedGame? @relation(fields: [gameId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, scope, createdAt])
  @@index([userId, scope, billingPeriodStart, type])
  @@index([userId, type, createdAt])
  @@index([analysisJobId])
  @@index([analysisRunId])
  @@index([gameId])
}

/// Canonical trainable user decision. Extraction reasons such as "avoid my
/// mistake" and "punish a missed opportunity" are metadata on this single
/// identity, never separate exercises.
model TrainingMoment {
  id                        String               @id @default(uuid()) @db.Uuid
  userId                    String               @db.Uuid
  gameId                    String               @db.Uuid
  momentKey                 String               @unique
  sourcePgnHash             String
  decisionPly               Int
  fen                       String
  positionHistory           String[]             @default([])
  sideToMove                String
  originalMoveUci           String
  scoreBefore               Json
  scoreAfter                Json
  cpLoss                    Float?
  winChanceLoss             Float?
  confidence                Float?
  phase                     GamePhase?
  status                    TrainingMomentStatus @default(ACTIVE)
  sourceKinds               TrainingSourceKind[] @default([])
  lessonKinds               TrainingLessonKind[] @default([])
  themes                    String[]             @default([])
  currentSolutionRevisionId String?              @db.Uuid
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @default(now()) @updatedAt
  lastTrainedAt             DateTime?
  archivedAt                DateTime?

  user                    User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  game                    AnalyzedGame                @relation(fields: [gameId, userId], references: [id, userId], onDelete: Cascade)
  currentSolutionRevision SolutionRevision?           @relation("CurrentSolutionRevision", fields: [currentSolutionRevisionId], references: [id], onDelete: SetNull)
  solutionRevisions       SolutionRevision[]          @relation("MomentSolutionRevisions")
  observations            TrainingMomentObservation[]
  attempts                TrainingAttempt[]
  practiceExposures       PracticeExposure[]
  practiceReviewStates    PracticeReviewState[]

  @@unique([gameId, sourcePgnHash, decisionPly])
  @@unique([id, userId])
  @@unique([currentSolutionRevisionId])
  @@index([userId, status, archivedAt])
  @@index([userId, status, lastTrainedAt, createdAt])
  @@index([gameId, archivedAt])
}

model SolutionRevision {
  id                 String             @id @default(uuid()) @db.Uuid
  momentId           String             @db.Uuid
  analysisRunId      String             @db.Uuid
  revision           Int
  solutionHash       String
  verificationStatus VerificationStatus
  solutionShape      SolutionShape
  gradingStrategy    GradingStrategy
  continuationShape  ContinuationShape
  trainable          Boolean            @default(true)
  bestMoveUci        String
  acceptedMovesUci   String[]           @default([])
  acceptanceFrontier Json
  bestLine           Json
  solutionTree       Json               @default(dbgenerated("'{}'::jsonb"))
  scoreAtStart       Json?
  playedMoveScore    Json?
  targetOutcome      Json               @default(dbgenerated("'{}'::jsonb"))
  gradingPolicy      Json
  evidence           Json               @default(dbgenerated("'{}'::jsonb"))
  generatorVersion   String
  configHash         String
  createdAt          DateTime           @default(now())

  moment            TrainingMoment              @relation("MomentSolutionRevisions", fields: [momentId], references: [id], onDelete: Cascade)
  currentForMoment  TrainingMoment?             @relation("CurrentSolutionRevision")
  analysisRun       AnalysisRun                 @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  moveAssessments   SolutionMoveAssessment[]
  observations      TrainingMomentObservation[]
  attempts          TrainingAttempt[]
  practiceExposures PracticeExposure[]

  @@unique([momentId, revision])
  @@unique([momentId, analysisRunId])
  @@unique([id, momentId])
  @@index([solutionHash])
  @@index([analysisRunId])
}

/// Immutable provenance link for every run that observed a moment, including
/// runs whose grading semantics reused an existing SolutionRevision.
model TrainingMomentObservation {
  momentId             String   @db.Uuid
  analysisRunId        String   @db.Uuid
  solutionRevisionId   String   @db.Uuid
  observedSolutionHash String
  evidence             Json     @default(dbgenerated("'{}'::jsonb"))
  createdAt            DateTime @default(now())

  moment           TrainingMoment   @relation(fields: [momentId], references: [id], onDelete: Cascade)
  analysisRun      AnalysisRun      @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  solutionRevision SolutionRevision @relation(fields: [solutionRevisionId, momentId], references: [id, momentId], onDelete: Cascade)

  @@id([momentId, analysisRunId])
  @@index([analysisRunId])
  @@index([solutionRevisionId])
}

model SolutionMoveAssessment {
  id                 String               @id @default(uuid()) @db.Uuid
  solutionRevisionId String               @db.Uuid
  positionKey        String
  decisionIndex      Int
  fen                String
  moveUci            String
  source             MoveAssessmentSource
  status             MoveAssessmentStatus @default(PENDING)
  grade              AttemptGrade?
  scoreAfter         Json?
  evidence           Json                 @default(dbgenerated("'{}'::jsonb"))
  attempts           Int                  @default(0)
  lockedAt           DateTime?
  lockedUntil        DateTime?
  lastError          String?              @db.Text
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @default(now()) @updatedAt

  solutionRevision SolutionRevision @relation(fields: [solutionRevisionId], references: [id], onDelete: Cascade)

  @@unique([solutionRevisionId, decisionIndex, positionKey, moveUci], map: "SolutionMoveAssessment_revision_decision_position_move_key")
  @@index([solutionRevisionId, decisionIndex])
  @@index([status, lockedUntil, createdAt])
}

model TrainingAttempt {
  id                          String                @id @default(uuid()) @db.Uuid
  trainingMomentId            String                @db.Uuid
  userId                      String                @db.Uuid
  solutionRevisionId          String                @db.Uuid
  clientAttemptId             String
  attemptedAt                 DateTime              @default(now())
  userMoveUci                 String?
  timeSpentMs                 Int?
  status                      AttemptStatus         @default(PENDING)
  grade                       AttemptGrade?
  gradingSource               MoveAssessmentSource?
  gradingEvidence             Json                  @default(dbgenerated("'{}'::jsonb"))
  bestGapCp                   Int?
  bestGapWinChance            Float?
  recoveredCp                 Int?
  recoveredWinChance          Float?
  completedAt                 DateTime?
  contextPhase                GamePhase?
  contextCpLoss               Float?
  contextWinChanceLoss        Float?
  contextSourceKinds          TrainingSourceKind[]  @default([])
  contextLessonKinds          TrainingLessonKind[]  @default([])
  contextThemes               String[]              @default([])
  contextThemeTaxonomyVersion String                @default("backranq-theme-v1")
  contextProvider             GameSource
  contextTimeClass            TimeClass
  contextConfigHash           String
  contextSolutionHash         String

  trainingMoment    TrainingMoment               @relation(fields: [trainingMomentId, userId], references: [id, userId], onDelete: Cascade)
  user              User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  solutionRevision  SolutionRevision             @relation(fields: [solutionRevisionId, trainingMomentId], references: [id, momentId], onDelete: Cascade)
  steps             TrainingAttemptStep[]
  practiceExposures PracticeExposure[]
  statusEvents      TrainingAttemptStatusEvent[]
  reviewEvents      PracticeReviewEvent[]

  @@unique([userId, clientAttemptId])
  @@unique([id, userId])
  @@index([trainingMomentId])
  @@index([userId])
  @@index([solutionRevisionId])
  @@index([userId, trainingMomentId])
  @@index([userId, trainingMomentId, solutionRevisionId])
  @@index([userId, attemptedAt, status])
  @@index([userId, contextProvider, contextTimeClass, attemptedAt])
  @@index([userId, contextPhase, attemptedAt])
}

model TrainingAttemptStep {
  id          String           @id @default(uuid()) @db.Uuid
  attemptId   String           @db.Uuid
  stepIndex   Int
  actor       AttemptStepActor
  fenBefore   String
  moveUci     String
  grade       AttemptGrade?
  evidence    Json             @default(dbgenerated("'{}'::jsonb"))
  timeSpentMs Int?
  createdAt   DateTime         @default(now())

  attempt TrainingAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, stepIndex])
  @@index([attemptId])
}

/// Append-only lifecycle records for a Position being shown and leaving the
/// active Practice surface. `clientExposureId` correlates the SHOWN and
/// TERMINAL records without turning an exposure into mutable session state.
model PracticeExposure {
  id                 String                          @id @default(uuid()) @db.Uuid
  userId             String                          @db.Uuid
  trainingMomentId   String                          @db.Uuid
  solutionRevisionId String                          @db.Uuid
  attemptId          String?                         @db.Uuid
  clientExposureId   String
  clientEventId      String
  kind               PracticeExposureEventKind
  shownAt            DateTime
  clientOccurredAt   DateTime
  recordedAt         DateTime                        @default(now())
  entrySurface       PracticeEntrySurface
  recommendationKey  String?
  focus              PracticeFocus?
  terminalReason     PracticeExposureTerminalReason?

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainingMoment   TrainingMoment   @relation(fields: [trainingMomentId, userId], references: [id, userId], onDelete: Cascade)
  solutionRevision SolutionRevision @relation(fields: [solutionRevisionId, trainingMomentId], references: [id, momentId], onDelete: Cascade)
  attempt          TrainingAttempt? @relation(fields: [attemptId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([userId, clientEventId])
  @@index([userId, recordedAt])
  @@index([userId, kind, recordedAt])
  @@index([trainingMomentId, recordedAt])
  @@index([solutionRevisionId])
  @@index([attemptId])
  @@index([userId, clientExposureId, recordedAt])
}

/// Append-only status history. TrainingAttempt remains the current-state row;
/// this table makes unresolved/retry/grade/reveal transitions auditable.
model TrainingAttemptStatusEvent {
  id         String                           @id @default(uuid()) @db.Uuid
  attemptId  String                           @db.Uuid
  userId     String                           @db.Uuid
  eventKey   String
  status     AttemptStatus
  grade      AttemptGrade?
  reason     TrainingAttemptStatusEventReason
  occurredAt DateTime
  recordedAt DateTime                         @default(now())

  attempt TrainingAttempt @relation(fields: [attemptId, userId], references: [id, userId], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([attemptId, eventKey])
  @@index([userId, occurredAt])
  @@index([userId, status, occurredAt])
}

/// Current due-state for one user, Position, and immutable solution semantics.
/// This is scheduling state, not a Practice session or goal.
model PracticeReviewState {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  trainingMomentId String   @db.Uuid
  solutionHash     String
  configHash       String
  nextDueAt        DateTime
  intervalDays     Int
  lapses           Int      @default(0)
  successes        Int      @default(0)
  algorithmVersion String
  lastReviewedAt   DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainingMoment TrainingMoment        @relation(fields: [trainingMomentId, userId], references: [id, userId], onDelete: Cascade)
  events         PracticeReviewEvent[]

  @@unique([userId, trainingMomentId, solutionHash, configHash])
  @@index([userId, nextDueAt, id])
  @@index([nextDueAt, id])
  @@index([trainingMomentId])
}

/// Durable, bounded scan of one due snapshot. A queue retry always resumes from
/// the committed raw-state tuple instead of repeating an unbounded aggregate.
model PracticeDueSweep {
  id              String                 @id @default(uuid()) @db.Uuid
  referenceAt     DateTime               @unique
  status          PracticeDueSweepStatus @default(SCANNING)
  cursorNextDueAt DateTime?
  cursorStateId   String?                @db.Uuid
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @default(now()) @updatedAt
  completedAt     DateTime?

  users PracticeDueSweepUser[]

  @@index([status, completedAt, id])
}

model PracticeDueSweepUser {
  sweepId         String   @db.Uuid
  userId          String   @db.Uuid
  dueCount        Int
  dueCountIsExact Boolean  @default(true)
  earliestDueAt   DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  sweep PracticeDueSweep @relation(fields: [sweepId], references: [id], onDelete: Cascade)
  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sweepId, userId])
  @@index([userId, createdAt])
}

/// Append-only evidence used to derive PracticeReviewState.
model PracticeReviewEvent {
  id                 String                @id @default(uuid()) @db.Uuid
  stateId            String                @db.Uuid
  attemptId          String?               @db.Uuid
  userId             String                @db.Uuid
  eventKey           String
  outcome            PracticeReviewOutcome
  grade              AttemptGrade?
  occurredAt         DateTime
  recordedAt         DateTime              @default(now())
  intervalBeforeDays Int
  intervalAfterDays  Int
  nextDueAt          DateTime
  algorithmVersion   String

  state   PracticeReviewState @relation(fields: [stateId], references: [id], onDelete: Cascade)
  attempt TrainingAttempt?    @relation(fields: [attemptId, userId], references: [id, userId], onDelete: Cascade)
  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventKey])
  @@index([userId, occurredAt])
  @@index([stateId, occurredAt])
  @@index([attemptId])
}

/// Minimal typed product analytics for Progress. There is deliberately no
/// free-form payload field, so Positions, moves, FENs, or solutions cannot leak.
model ProgressAnalyticsEvent {
  id                String                     @id @default(uuid()) @db.Uuid
  userId            String                     @db.Uuid
  clientEventId     String
  eventName         ProgressAnalyticsEventName
  occurredAt        DateTime
  recordedAt        DateTime                   @default(now())
  insightKey        String?
  actionKey         String?
  recommendationKey String?
  windowDays        Int?
  provider          GameSource?
  timeClass         TimeClass?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientEventId])
  @@index([userId, eventName, occurredAt])
  @@index([userId, occurredAt])
  @@index([userId, recordedAt])
}

model ProgressAnalyticsRateBucket {
  userId          String   @id @db.Uuid
  windowStartedAt DateTime
  eventCount      Int
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Strict acquisition analytics for dual onboarding. There is intentionally no
/// free-form JSON, username, PGN, FEN, source URL, or move field.
model OnboardingAnalyticsEvent {
  id                String                 @id @default(uuid()) @db.Uuid
  sessionId         String                 @db.Uuid
  eventId           String
  onboardingRunId   String?                @db.Uuid
  userId            String?                @db.Uuid
  eventName         OnboardingEventName
  provider          SyncProvider?
  puzzleKind        OnboardingPuzzleKind?
  experimentKey     String?
  variantKey        String?
  durationMs        Int?
  gameCount         Int?
  gameIndex         Int?
  progressMilestone Int?
  reason            String?
  masterState       OnboardingMasterState?
  occurredAt        DateTime
  recordedAt        DateTime               @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([sessionId, eventId])
  @@index([eventName, occurredAt])
  @@index([sessionId, occurredAt])
  @@index([onboardingRunId, occurredAt])
  @@index([userId, occurredAt])
}

model OnboardingRateBucket {
  keyHash         String
  namespace       String
  windowStartedAt DateTime
  requestCount    Int
  updatedAt       DateTime @updatedAt

  @@id([keyHash, namespace])
  @@index([windowStartedAt])
}

/// Editorial identity shown in Weekly Master attribution. This is deliberately
/// separate from User: roster membership never implies a Backranq account or an
/// endorsement relationship.
model MasterPerson {
  id               String   @id @default(uuid()) @db.Uuid
  slug             String   @unique
  displayName      String
  attributionLabel String
  active           Boolean  @default(true)
  priority         Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  accounts   MasterAccount[]
  candidates MasterCandidate[]
  overrides  MasterAdminOverride[]

  @@index([active, priority])
}

model MasterAccount {
  id                  String       @id @default(uuid()) @db.Uuid
  personId            String       @db.Uuid
  provider            SyncProvider
  username            String
  usernameNormalized  String
  profileUrl          String
  identityEvidence    Json         @default(dbgenerated("'{}'::jsonb"))
  identityVerifiedAt  DateTime?
  active              Boolean      @default(true)
  priority            Int          @default(0)
  lastFetchAt         DateTime?
  lastSuccessAt       DateTime?
  nextFetchAt         DateTime?
  etag                String?      @db.Text
  lastModified        String?      @db.Text
  consecutiveFailures Int          @default(0)
  lastError           String?      @db.Text
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  person           MasterPerson                @relation(fields: [personId], references: [id], onDelete: Restrict)
  discoveries      MasterSourceGameDiscovery[]
  candidates       MasterCandidate[]
  analysisReceipts MasterAnalysisReceipt[]
  overrides        MasterAdminOverride[]

  @@unique([provider, usernameNormalized])
  @@index([active, nextFetchAt, priority])
  @@index([personId, active])
}

model MasterSourceGame {
  id                String                   @id @default(uuid()) @db.Uuid
  provider          SyncProvider
  externalId        String
  canonicalUrl      String?
  availability      MasterSourceAvailability @default(AVAILABLE)
  currentSnapshotId String?                  @unique @db.Uuid
  firstSeenAt       DateTime                 @default(now())
  lastSeenAt        DateTime                 @default(now())
  lastCheckedAt     DateTime                 @default(now())
  missingSince      DateTime?
  lastError         String?                  @db.Text
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  currentSnapshot MasterSourceGameSnapshot?   @relation("MasterCurrentSnapshot", fields: [currentSnapshotId], references: [id], onDelete: SetNull)
  snapshots       MasterSourceGameSnapshot[]  @relation("MasterSourceSnapshots")
  discoveries     MasterSourceGameDiscovery[]

  @@unique([provider, externalId])
  @@index([availability, lastCheckedAt])
}

model MasterSourceGameDiscovery {
  sourceGameId String       @db.Uuid
  accountId    String       @db.Uuid
  featuredSide GameUserSide @default(UNKNOWN)
  firstSeenAt  DateTime     @default(now())
  lastSeenAt   DateTime     @default(now())

  sourceGame MasterSourceGame @relation(fields: [sourceGameId], references: [id], onDelete: Cascade)
  account    MasterAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([sourceGameId, accountId])
  @@index([accountId, lastSeenAt])
}

/// Immutable provider response normalized at fetch time. A provider correction
/// creates a new row instead of mutating evidence that may already be public.
model MasterSourceGameSnapshot {
  id                          String    @id @default(uuid()) @db.Uuid
  sourceGameId                String    @db.Uuid
  pipelineRunId               String?   @db.Uuid
  snapshotHash                String
  pgnHash                     String
  pgn                         String    @db.Text
  sourceUrl                   String?
  playedAt                    DateTime
  timeClass                   TimeClass
  timeControlRaw              String?
  timeControlInitialSeconds   Int?
  timeControlIncrementSeconds Int?
  rated                       Boolean?
  result                      String?
  termination                 String?
  whiteName                   String
  whiteRating                 Int?
  blackName                   String
  blackRating                 Int?
  providerMetadata            Json      @default(dbgenerated("'{}'::jsonb"))
  fetchedAt                   DateTime  @default(now())

  sourceGame       MasterSourceGame        @relation("MasterSourceSnapshots", fields: [sourceGameId], references: [id], onDelete: Restrict)
  currentForGame   MasterSourceGame?       @relation("MasterCurrentSnapshot")
  pipelineRun      MasterPipelineRun?      @relation(fields: [pipelineRunId], references: [id], onDelete: SetNull)
  candidates       MasterCandidate[]
  analysisReceipts MasterAnalysisReceipt[]

  @@unique([sourceGameId, snapshotHash])
  @@index([sourceGameId, fetchedAt])
  @@index([pgnHash])
}

model MasterPipelineRun {
  id                 String                @id @default(uuid()) @db.Uuid
  runKey             String                @unique
  status             MasterPipelineStatus  @default(QUEUED)
  stage              MasterPipelineStage   @default(SOURCE)
  trigger            MasterPipelineTrigger @default(SCHEDULED)
  scheduledFor       DateTime              @default(now())
  lockedUntil        DateTime?
  leaseToken         String?
  attempts           Int                   @default(0)
  configSnapshot     Json                  @default(dbgenerated("'{}'::jsonb"))
  configHash         String
  fetchedGames       Int                   @default(0)
  createdSnapshots   Int                   @default(0)
  analyzedSnapshots  Int                   @default(0)
  eligibleCandidates Int                   @default(0)
  publishedCount     Int                   @default(0)
  lastError          String?               @db.Text
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  snapshots        MasterSourceGameSnapshot[]
  candidates       MasterCandidate[]
  analysisReceipts MasterAnalysisReceipt[]

  @@index([status, scheduledFor])
  @@index([lockedUntil])
  @@index([createdAt])
}

/// Durable proof that a specific immutable snapshot/account/config was fully
/// analyzed, including the valid case where no publishable moment was found.
model MasterAnalysisReceipt {
  id             String   @id @default(uuid()) @db.Uuid
  snapshotId     String   @db.Uuid
  accountId      String   @db.Uuid
  pipelineRunId  String   @db.Uuid
  configHash     String
  complete       Boolean  @default(false)
  candidateCount Int      @default(0)
  manifest       Json     @default(dbgenerated("'{}'::jsonb"))
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  snapshot    MasterSourceGameSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  account     MasterAccount            @relation(fields: [accountId], references: [id], onDelete: Restrict)
  pipelineRun MasterPipelineRun        @relation(fields: [pipelineRunId], references: [id], onDelete: Restrict)

  @@unique([snapshotId, accountId, configHash])
  @@index([pipelineRunId, complete])
  @@index([accountId, createdAt])
}

model MasterCandidate {
  id                    String                @id @default(uuid()) @db.Uuid
  snapshotId            String                @db.Uuid
  personId              String                @db.Uuid
  accountId             String                @db.Uuid
  pipelineRunId         String                @db.Uuid
  candidateKey          String                @unique
  decisionPly           Int
  fen                   String
  positionHistory       String[]              @default([])
  sideToMove            String
  originalMoveUci       String
  scoreBefore           Json
  scoreAfter            Json
  cpLoss                Float?
  winChanceLoss         Float?
  phase                 GamePhase?
  sourceKinds           TrainingSourceKind[]  @default([])
  lessonKinds           TrainingLessonKind[]  @default([])
  themes                String[]              @default([])
  verificationStatus    VerificationStatus
  solutionShape         SolutionShape
  gradingStrategy       GradingStrategy
  continuationShape     ContinuationShape
  bestMoveUci           String
  acceptedMovesUci      String[]              @default([])
  acceptanceFrontier    Json
  bestLine              Json
  solutionTree          Json                  @default(dbgenerated("'{}'::jsonb"))
  moveAssessments       Json                  @default(dbgenerated("'[]'::jsonb"))
  scoreAtStart          Json?
  playedMoveScore       Json?
  targetOutcome         Json                  @default(dbgenerated("'{}'::jsonb"))
  gradingPolicy         Json
  evidence              Json                  @default(dbgenerated("'{}'::jsonb"))
  solutionHash          String
  generatorVersion      String
  configHash            String
  hardGatePassed        Boolean
  rejectionReasons      String[]              @default([])
  freshnessScore        Float
  recognitionScore      Float
  clarityScore          Float
  engineConfidenceScore Float
  humanInterestScore    Float
  solutionLengthScore   Float
  totalScore            Float
  status                MasterCandidateStatus
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  snapshot    MasterSourceGameSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  person      MasterPerson             @relation(fields: [personId], references: [id], onDelete: Restrict)
  account     MasterAccount            @relation(fields: [accountId], references: [id], onDelete: Restrict)
  pipelineRun MasterPipelineRun        @relation(fields: [pipelineRunId], references: [id], onDelete: Restrict)
  publication MasterPublication?

  @@unique([snapshotId, personId, decisionPly, configHash])
  @@index([hardGatePassed, totalScore, createdAt])
  @@index([personId, status])
  @@index([pipelineRunId, status])
}

model MasterPublication {
  id               String                  @id @default(uuid()) @db.Uuid
  slug             String                  @unique
  candidateId      String                  @unique @db.Uuid
  status           MasterPublicationStatus @default(PUBLISHED)
  health           MasterPublicationHealth @default(FRESH)
  headline         String
  teaser           String
  attributionLabel String
  promptPayload    Json
  reviewPayload    Json
  sourceUrl        String?
  contentHash      String                  @unique
  isFallback       Boolean                 @default(false)
  publishedAt      DateTime                @default(now())
  lastCheckedAt    DateTime?
  staleSince       DateTime?
  healthReason     String?
  withdrawnAt      DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  candidate         MasterCandidate       @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  currentForSlots   MasterSlot[]          @relation("MasterSlotCurrentPublication")
  fallbackForSlots  MasterSlot[]          @relation("MasterSlotFallbackPublication")
  scopedOverrides   MasterAdminOverride[] @relation("MasterOverridePublication")
  targetedOverrides MasterAdminOverride[] @relation("MasterOverrideTargetPublication")

  @@index([status, health, publishedAt])
  @@index([isFallback, status])
}

model MasterSlot {
  id                    String    @id @default(uuid()) @db.Uuid
  key                   String    @unique
  currentPublicationId  String?   @db.Uuid
  fallbackPublicationId String?   @db.Uuid
  version               Int       @default(0)
  resolvedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  currentPublication  MasterPublication?    @relation("MasterSlotCurrentPublication", fields: [currentPublicationId], references: [id], onDelete: SetNull)
  fallbackPublication MasterPublication?    @relation("MasterSlotFallbackPublication", fields: [fallbackPublicationId], references: [id], onDelete: SetNull)
  overrides           MasterAdminOverride[]

  @@index([currentPublicationId])
  @@index([fallbackPublicationId])
}

model MasterAdminOverride {
  id                  String             @id @default(uuid()) @db.Uuid
  kind                MasterOverrideKind
  slotId              String?            @db.Uuid
  personId            String?            @db.Uuid
  accountId           String?            @db.Uuid
  publicationId       String?            @db.Uuid
  targetPublicationId String?            @db.Uuid
  startsAt            DateTime           @default(now())
  expiresAt           DateTime
  reason              String             @db.Text
  createdByAdminId    String             @db.Uuid
  revokedAt           DateTime?
  revokedByAdminId    String?            @db.Uuid
  revokeReason        String?            @db.Text
  metadata            Json               @default(dbgenerated("'{}'::jsonb"))
  createdAt           DateTime           @default(now())

  slot              MasterSlot?        @relation(fields: [slotId], references: [id], onDelete: Cascade)
  person            MasterPerson?      @relation(fields: [personId], references: [id], onDelete: Cascade)
  account           MasterAccount?     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  publication       MasterPublication? @relation("MasterOverridePublication", fields: [publicationId], references: [id], onDelete: Cascade)
  targetPublication MasterPublication? @relation("MasterOverrideTargetPublication", fields: [targetPublicationId], references: [id], onDelete: Cascade)
  createdByAdmin    AdminMembership    @relation("MasterOverrideCreatedBy", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  revokedByAdmin    AdminMembership?   @relation("MasterOverrideRevokedBy", fields: [revokedByAdminId], references: [id], onDelete: Restrict)

  @@index([slotId, startsAt, expiresAt])
  @@index([personId, startsAt, expiresAt])
  @@index([accountId, startsAt, expiresAt])
  @@index([publicationId, startsAt, expiresAt])
  @@index([expiresAt, revokedAt])
}

// NextAuth (Auth.js) Prisma Adapter models
model Account {
  id                String  @id @default(cuid())
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
