generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Recommended for serverless: use a pooled DATABASE_URL at runtime,
  // and a non-pooled DIRECT_URL for migrations.
  directUrl = env("DIRECT_URL")
}

enum Provider {
  LICHESS
  CHESSCOM
}

enum TimeClass {
  BULLET
  BLITZ
  RAPID
  CLASSICAL
  UNKNOWN
}

enum PuzzleType {
  AVOID_BLUNDER
  PUNISH_BLUNDER
}

enum PuzzleKind {
  BLUNDER
  MISSED_WIN
  MISSED_TACTIC
}

enum GamePhase {
  OPENING
  MIDDLEGAME
  ENDGAME
}

enum AnalysisJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model User {
  id               String   @id @default(uuid()) @db.Uuid
  email            String?  @unique
  emailVerified    DateTime?
  name             String?
  image            String?
  lichessUsername  String?
  chesscomUsername String?
  preferences      Json     @default(dbgenerated("'{}'::jsonb"))
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  games          AnalyzedGame[]
  puzzles        Puzzle[]
  puzzleAttempts PuzzleAttempt[]
  providerSyncStates ProviderSyncState[]
  analysisJobs   AnalysisJob[]

  // NextAuth (Auth.js) relations
  accounts Account[]
  sessions Session[]
}

model AnalyzedGame {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  provider         Provider
  externalId       String
  url              String?
  pgn              String    @db.Text
  playedAt         DateTime
  timeClass        TimeClass
  rated            Boolean?
  result           String?
  termination      String?
  whiteName        String
  whiteRating      Int?
  blackName        String
  blackRating      Int?
  openingEco       String?
  openingName      String?
  openingVariation String?
  analysis         Json
  analyzedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  puzzles Puzzle[]
  analysisJobs AnalysisJob[]

  @@unique([userId, provider, externalId])
  @@index([userId])
  @@index([provider, externalId])
}

model ProviderSyncState {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @db.Uuid
  provider           Provider
  enabled            Boolean   @default(true)
  lastSyncedPlayedAt DateTime?
  lastAttemptAt      DateTime?
  lastSuccessAt      DateTime?
  lastError          String?   @db.Text
  etag               String?   @db.Text
  lastModified       String?   @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([provider, enabled])
  @@index([lastAttemptAt])
}

model AnalysisJob {
  id           String            @id @default(uuid()) @db.Uuid
  userId       String            @db.Uuid
  gameId       String            @db.Uuid
  status       AnalysisJobStatus @default(QUEUED)
  priority     Int               @default(0)
  attempts     Int               @default(0)
  lockedAt     DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  lastError    String?           @db.Text
  queuedReason String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game AnalyzedGame @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId])
  @@index([userId, status])
  @@index([status, priority, createdAt])
  @@index([lockedAt])
}

model Puzzle {
  id               String     @id @default(uuid()) @db.Uuid
  userId           String     @db.Uuid
  gameId           String     @db.Uuid
  sourcePly        Int
  fen              String
  type             PuzzleType
  kind             PuzzleKind @default(BLUNDER)
  phase            GamePhase?
  severity         String?
  bestMoveUci      String
  acceptedMovesUci String[]   @default([])
  bestLine         Json
  score            Json
  tags             String[]   @default([])
  openingEco       String?
  openingName      String?
  openingVariation String?
  label            String?
  createdAt        DateTime   @default(now())
  archivedAt       DateTime?

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  game     AnalyzedGame    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  attempts PuzzleAttempt[]

  @@unique([gameId, sourcePly, fen])
  @@index([userId])
  @@index([gameId])
  @@index([userId, archivedAt])
  @@index([gameId, archivedAt])
}

model PuzzleAttempt {
  id          String   @id @default(uuid()) @db.Uuid
  puzzleId    String   @db.Uuid
  userId      String   @db.Uuid
  attemptedAt DateTime @default(now())
  userMoveUci String
  wasCorrect  Boolean
  timeSpentMs Int?

  puzzle Puzzle @relation(fields: [puzzleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([puzzleId])
  @@index([userId])
  @@index([userId, puzzleId])
  @@index([userId, puzzleId, wasCorrect])
}

// NextAuth (Auth.js) Prisma Adapter models
model Account {
  id                String  @id @default(cuid())
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
