generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Recommended for serverless: use a pooled DATABASE_URL at runtime,
  // and a non-pooled DIRECT_URL for migrations.
  directUrl = env("DIRECT_URL")
}

enum Provider {
  LICHESS
  CHESSCOM
}

enum TimeClass {
  BULLET
  BLITZ
  RAPID
  CLASSICAL
  UNKNOWN
}

enum TrainingMomentStatus {
  ACTIVE
  UNSTABLE
  INVALIDATED
  ARCHIVED
}

enum TrainingSourceKind {
  MY_MISTAKE
  MISSED_OPPORTUNITY
}

enum TrainingLessonKind {
  AVOID_MISTAKE
  PUNISH_MISTAKE
  SAVE_DRAW
  PRESERVE_WIN
  CONVERT_ADVANTAGE
  IMPROVE_POSITION
}

enum VerificationStatus {
  VERIFIED
  AMBIGUOUS
  UNSTABLE
  INVALID
}

enum SolutionShape {
  UNIQUE
  MULTIPLE
  OPEN
}

enum GradingStrategy {
  PRECOMPUTED
  OUTCOME_TOLERANCE
  DYNAMIC
  TABLEBASE
}

enum ContinuationShape {
  SINGLE_DECISION
  CONDITIONAL_LINE
}

enum AttemptStatus {
  PENDING
  GRADED
  REVEALED
  SKIPPED
  UNRESOLVED
}

enum AttemptGrade {
  BEST
  GOOD
  IMPROVED
  REPEATED_MISTAKE
  DIFFERENT_MISTAKE
}

enum MoveAssessmentSource {
  PRECOMPUTED
  DYNAMIC
  TABLEBASE
}

enum MoveAssessmentStatus {
  PENDING
  VERIFIED
  FAILED
}

enum AttemptStepActor {
  USER
  ENGINE
}

enum GamePhase {
  OPENING
  MIDDLEGAME
  ENDGAME
}

enum AnalysisJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum SyncJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AnalysisExecutionMode {
  LOCAL_BROWSER
  SERVER_QUEUE
  EXTERNAL_WORKER
}

enum AnalysisRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum CreditLedgerEntryType {
  RESERVED
  CONSUMED
  REFUNDED
  RELEASED
  EXPIRED
}

enum BillingPlan {
  FREE
  PLUS
  PRO
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  email            String?   @unique
  emailVerified    DateTime?
  name             String?
  image            String?
  lichessUsername  String?
  chesscomUsername String?
  preferences      Json      @default(dbgenerated("'{}'::jsonb"))
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  games               AnalyzedGame[]
  trainingMoments     TrainingMoment[]
  trainingAttempts    TrainingAttempt[]
  providerSyncStates  ProviderSyncState[]
  historyImportQuotas HistoryImportQuota[]
  syncJobs            SyncJob[]
  analysisJobs        AnalysisJob[]
  analysisRuns        AnalysisRun[]
  creditLedgerEntries CreditLedgerEntry[]
  billingAccount      BillingAccount?

  // NextAuth (Auth.js) relations
  accounts Account[]
  sessions Session[]
}

model BillingAccount {
  id                        String      @id @default(uuid()) @db.Uuid
  userId                    String      @unique @db.Uuid
  plan                      BillingPlan @default(FREE)
  stripeCustomerId          String?     @unique
  stripeSubscriptionId      String?     @unique
  stripeSubscriptionStatus  String?
  stripePriceId             String?
  stripeCurrentPeriodEnd    DateTime?
  stripeLastEventCreatedAt  DateTime?
  stripeLastEventId         String?
  serverCreditsBalance      Int         @default(100)
  monthlyServerCreditsUsed  Int         @default(0)
  serverCreditsRenewAt      DateTime    @default(dbgenerated("(now() + '1 mon'::interval)"))
  monthlyServerCreditsLimit Int         @default(100)
  autoAnalysisMonthlyCap    Int         @default(50)
  autoAnalysisDailyCap      Int         @default(10)
  stopWhenCreditsBelow      Int         @default(0)
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([plan])
  @@index([stripePriceId])
  @@index([stripeSubscriptionStatus])
  @@index([serverCreditsRenewAt])
}

model StripeWebhookEvent {
  id              String    @id
  type            String
  status          String    @default("PROCESSING")
  attempts        Int       @default(1)
  lastError       String?   @db.Text
  processedAt     DateTime?
  processingToken String?
  processingUntil DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, updatedAt])
  @@index([status, processingUntil])
  @@index([type, createdAt])
}

model AnalyzedGame {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @db.Uuid
  provider             Provider
  externalId           String
  url                  String?
  pgn                  String    @db.Text
  playedAt             DateTime
  timeClass            TimeClass
  rated                Boolean?
  result               String?
  termination          String?
  whiteName            String
  whiteRating          Int?
  blackName            String
  blackRating          Int?
  openingEco           String?
  openingName          String?
  openingVariation     String?
  analysis             Json
  analyzedAt           DateTime?
  currentAnalysisRunId String?   @db.Uuid
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainingMoments     TrainingMoment[]
  analysisJobs        AnalysisJob[]
  analysisRuns        AnalysisRun[]       @relation("GameAnalysisRuns")
  currentAnalysisRun  AnalysisRun?        @relation("CurrentAnalysisRun", fields: [currentAnalysisRunId], references: [id], onDelete: SetNull)
  creditLedgerEntries CreditLedgerEntry[]

  @@unique([userId, provider, externalId])
  @@unique([id, userId])
  @@index([userId])
  @@index([provider, externalId])
  @@index([currentAnalysisRunId])
}

model ProviderSyncState {
  id                         String    @id @default(uuid()) @db.Uuid
  userId                     String    @db.Uuid
  provider                   Provider
  enabled                    Boolean   @default(true)
  providerUsernameNormalized String?
  lastSyncedPlayedAt         DateTime?
  cursorSincePlayedAt        DateTime?
  cursorUntilPlayedAt        DateTime?
  cursorWindowEnd            DateTime?
  lastAttemptAt              DateTime?
  lastSuccessAt              DateTime?
  lastError                  String?   @db.Text
  etag                       String?   @db.Text
  lastModified               String?   @db.Text
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([provider, enabled])
  @@index([lastAttemptAt])
}

model HistoryImportQuota {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @db.Uuid
  provider           Provider
  usernameNormalized String
  createdCount       Int      @default(0)
  fetchLeaseToken    String?
  fetchLeaseUntil    DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, usernameNormalized])
  @@index([userId, provider])
}

model SyncJob {
  id                  String        @id @default(uuid()) @db.Uuid
  userId              String        @db.Uuid
  provider            Provider
  status              SyncJobStatus @default(QUEUED)
  scheduledFor        DateTime      @default(now())
  lockedUntil         DateTime?
  leaseToken          String?
  attempts            Int           @default(0)
  lastError           String?       @db.Text
  startedAt           DateTime?
  completedAt         DateTime?
  fetchedCount        Int           @default(0)
  savedCount          Int           @default(0)
  createdCount        Int           @default(0)
  updatedCount        Int           @default(0)
  queuedAnalysisCount Int           @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, provider, status])
  @@index([status, scheduledFor])
  @@index([lockedUntil])
}

model AnalysisJob {
  id               String            @id @default(uuid()) @db.Uuid
  userId           String            @db.Uuid
  gameId           String            @db.Uuid
  analysisRunId    String            @db.Uuid
  status           AnalysisJobStatus @default(QUEUED)
  priority         Int               @default(0)
  attempts         Int               @default(0)
  scheduledFor     DateTime?
  lockedAt         DateTime?
  lockedUntil      DateTime?
  lastDispatchedAt DateTime?
  dispatchedCount  Int               @default(0)
  weight           Int               @default(0)
  estimatedCredits Int               @default(1)
  startedAt        DateTime?
  completedAt      DateTime?
  lastError        String?           @db.Text
  queuedReason     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  game                AnalyzedGame        @relation(fields: [gameId, userId], references: [id, userId], onDelete: Cascade)
  analysisRun         AnalysisRun         @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  creditLedgerEntries CreditLedgerEntry[]

  @@unique([gameId])
  @@index([userId, status])
  @@index([analysisRunId])
  @@index([status, priority, createdAt])
  @@index([status, scheduledFor, priority, createdAt])
  @@index([lockedAt])
  @@index([lockedUntil])
  @@index([lastDispatchedAt])
}

/// Durable serverless-safe operational counters. These counters are deliberately
/// separate from AnalysisJob so rejected stale deliveries cannot mutate the
/// currently fenced job generation.
model AnalysisOpsCounter {
  key       String   @id
  value     BigInt   @default(0)
  updatedAt DateTime @default(now()) @updatedAt
}

model AnalysisRun {
  id              String                @id @default(uuid()) @db.Uuid
  userId          String                @db.Uuid
  gameId          String                @db.Uuid
  executionMode   AnalysisExecutionMode
  status          AnalysisRunStatus     @default(QUEUED)
  queuedReason    String?
  engineName      String?
  engineVersion   String?
  engineSource    String?
  engineFlavor    String?
  engineEvalFile  String?
  engineOptions   Json                  @default(dbgenerated("'{}'::jsonb"))
  appVersion      String?
  inputPgnHash    String
  configSnapshot  Json                  @default(dbgenerated("'{}'::jsonb"))
  configHash      String
  startedAt       DateTime?
  completedAt     DateTime?
  durationMs      Int?
  consumedCredits Int?
  lastError       String?               @db.Text
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  user                       User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  game                       AnalyzedGame                @relation("GameAnalysisRuns", fields: [gameId, userId], references: [id, userId], onDelete: Cascade)
  currentForGames            AnalyzedGame[]              @relation("CurrentAnalysisRun")
  solutionRevisions          SolutionRevision[]
  trainingMomentObservations TrainingMomentObservation[]
  analysisJobs               AnalysisJob[]
  creditLedgerEntries        CreditLedgerEntry[]

  @@unique([id, gameId, userId])
  @@index([userId, status])
  @@index([gameId, createdAt])
  @@index([executionMode, status])
  @@index([configHash])
  @@index([inputPgnHash])
}

model CreditLedgerEntry {
  id             String                @id @default(uuid()) @db.Uuid
  userId         String                @db.Uuid
  analysisJobId  String?               @db.Uuid
  analysisRunId  String?               @db.Uuid
  gameId         String?               @db.Uuid
  type           CreditLedgerEntryType
  credits        Int
  idempotencyKey String                @unique
  reason         String?
  metadata       Json                  @default(dbgenerated("'{}'::jsonb"))
  createdAt      DateTime              @default(now())

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysisJob AnalysisJob?  @relation(fields: [analysisJobId], references: [id], onDelete: SetNull)
  analysisRun AnalysisRun?  @relation(fields: [analysisRunId], references: [id], onDelete: SetNull)
  game        AnalyzedGame? @relation(fields: [gameId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, type, createdAt])
  @@index([analysisJobId])
  @@index([analysisRunId])
  @@index([gameId])
}

/// Canonical trainable user decision. Extraction reasons such as "avoid my
/// mistake" and "punish a missed opportunity" are metadata on this single
/// identity, never separate exercises.
model TrainingMoment {
  id                        String               @id @default(uuid()) @db.Uuid
  userId                    String               @db.Uuid
  gameId                    String               @db.Uuid
  momentKey                 String               @unique
  sourcePgnHash             String
  decisionPly               Int
  fen                       String
  positionHistory           String[]             @default([])
  sideToMove                String
  originalMoveUci           String
  scoreBefore               Json
  scoreAfter                Json
  cpLoss                    Float?
  winChanceLoss             Float?
  confidence                Float?
  phase                     GamePhase?
  status                    TrainingMomentStatus @default(ACTIVE)
  sourceKinds               TrainingSourceKind[] @default([])
  lessonKinds               TrainingLessonKind[] @default([])
  themes                    String[]             @default([])
  currentSolutionRevisionId String?              @db.Uuid
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @default(now()) @updatedAt
  lastTrainedAt             DateTime?
  archivedAt                DateTime?

  user                    User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  game                    AnalyzedGame                @relation(fields: [gameId, userId], references: [id, userId], onDelete: Cascade)
  currentSolutionRevision SolutionRevision?           @relation("CurrentSolutionRevision", fields: [currentSolutionRevisionId], references: [id], onDelete: SetNull)
  solutionRevisions       SolutionRevision[]          @relation("MomentSolutionRevisions")
  observations            TrainingMomentObservation[]
  attempts                TrainingAttempt[]

  @@unique([gameId, sourcePgnHash, decisionPly])
  @@unique([id, userId])
  @@unique([currentSolutionRevisionId])
  @@index([userId, status, archivedAt])
  @@index([userId, status, lastTrainedAt, createdAt])
  @@index([gameId, archivedAt])
}

model SolutionRevision {
  id                 String             @id @default(uuid()) @db.Uuid
  momentId           String             @db.Uuid
  analysisRunId      String             @db.Uuid
  revision           Int
  solutionHash       String
  verificationStatus VerificationStatus
  solutionShape      SolutionShape
  gradingStrategy    GradingStrategy
  continuationShape  ContinuationShape
  trainable          Boolean            @default(true)
  bestMoveUci        String
  acceptedMovesUci   String[]           @default([])
  bestLine           Json
  solutionTree       Json               @default(dbgenerated("'{}'::jsonb"))
  scoreAtStart       Json?
  playedMoveScore    Json?
  targetOutcome      Json               @default(dbgenerated("'{}'::jsonb"))
  gradingPolicy      Json
  evidence           Json               @default(dbgenerated("'{}'::jsonb"))
  generatorVersion   String
  configHash         String
  createdAt          DateTime           @default(now())

  moment           TrainingMoment              @relation("MomentSolutionRevisions", fields: [momentId], references: [id], onDelete: Cascade)
  currentForMoment TrainingMoment?             @relation("CurrentSolutionRevision")
  analysisRun      AnalysisRun                 @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  moveAssessments  SolutionMoveAssessment[]
  observations     TrainingMomentObservation[]
  attempts         TrainingAttempt[]

  @@unique([momentId, revision])
  @@unique([momentId, analysisRunId])
  @@unique([id, momentId])
  @@index([solutionHash])
  @@index([analysisRunId])
}

/// Immutable provenance link for every run that observed a moment, including
/// runs whose grading semantics reused an existing SolutionRevision.
model TrainingMomentObservation {
  momentId             String   @db.Uuid
  analysisRunId        String   @db.Uuid
  solutionRevisionId   String   @db.Uuid
  observedSolutionHash String
  evidence             Json     @default(dbgenerated("'{}'::jsonb"))
  createdAt            DateTime @default(now())

  moment           TrainingMoment   @relation(fields: [momentId], references: [id], onDelete: Cascade)
  analysisRun      AnalysisRun      @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  solutionRevision SolutionRevision @relation(fields: [solutionRevisionId, momentId], references: [id, momentId], onDelete: Cascade)

  @@id([momentId, analysisRunId])
  @@index([analysisRunId])
  @@index([solutionRevisionId])
}

model SolutionMoveAssessment {
  id                 String               @id @default(uuid()) @db.Uuid
  solutionRevisionId String               @db.Uuid
  positionKey        String
  decisionIndex      Int
  fen                String
  moveUci            String
  source             MoveAssessmentSource
  status             MoveAssessmentStatus @default(PENDING)
  grade              AttemptGrade?
  scoreAfter         Json?
  evidence           Json                 @default(dbgenerated("'{}'::jsonb"))
  attempts           Int                  @default(0)
  lockedAt           DateTime?
  lockedUntil        DateTime?
  lastError          String?              @db.Text
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @default(now()) @updatedAt

  solutionRevision SolutionRevision @relation(fields: [solutionRevisionId], references: [id], onDelete: Cascade)

  @@unique([solutionRevisionId, decisionIndex, positionKey, moveUci], map: "SolutionMoveAssessment_revision_decision_position_move_key")
  @@index([solutionRevisionId, decisionIndex])
  @@index([status, lockedUntil, createdAt])
}

model TrainingAttempt {
  id                 String                @id @default(uuid()) @db.Uuid
  trainingMomentId   String                @db.Uuid
  userId             String                @db.Uuid
  solutionRevisionId String                @db.Uuid
  clientAttemptId    String
  attemptedAt        DateTime              @default(now())
  userMoveUci        String?
  timeSpentMs        Int?
  status             AttemptStatus         @default(PENDING)
  grade              AttemptGrade?
  gradingSource      MoveAssessmentSource?
  gradingEvidence    Json                  @default(dbgenerated("'{}'::jsonb"))
  bestGapCp          Int?
  bestGapWinChance   Float?
  recoveredCp        Int?
  recoveredWinChance Float?
  completedAt        DateTime?

  trainingMoment   TrainingMoment        @relation(fields: [trainingMomentId, userId], references: [id, userId], onDelete: Cascade)
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  solutionRevision SolutionRevision      @relation(fields: [solutionRevisionId, trainingMomentId], references: [id, momentId], onDelete: Cascade)
  steps            TrainingAttemptStep[]

  @@unique([userId, clientAttemptId])
  @@index([trainingMomentId])
  @@index([userId])
  @@index([solutionRevisionId])
  @@index([userId, trainingMomentId])
  @@index([userId, trainingMomentId, solutionRevisionId])
}

model TrainingAttemptStep {
  id          String           @id @default(uuid()) @db.Uuid
  attemptId   String           @db.Uuid
  stepIndex   Int
  actor       AttemptStepActor
  fenBefore   String
  moveUci     String
  grade       AttemptGrade?
  evidence    Json             @default(dbgenerated("'{}'::jsonb"))
  timeSpentMs Int?
  createdAt   DateTime         @default(now())

  attempt TrainingAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, stepIndex])
  @@index([attemptId])
}

// NextAuth (Auth.js) Prisma Adapter models
model Account {
  id                String  @id @default(cuid())
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
