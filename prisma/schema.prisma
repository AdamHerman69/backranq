generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Recommended for serverless: use a pooled DATABASE_URL at runtime,
  // and a non-pooled DIRECT_URL for migrations.
  directUrl = env("DIRECT_URL")
}

