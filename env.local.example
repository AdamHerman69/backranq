# Database
# Use the Supabase pooler URL for runtime/serverless connections.
# Keep `pgbouncer=true` on pooler URLs to avoid prepared statement errors.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?schema=public&pgbouncer=true"

# Use the direct database URL for Prisma migrations.
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# Supabase API
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-or-publishable-key>"
SUPABASE_SERVICE_ROLE_KEY="<optional-service-role-key>"

# Auth.js / NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="<generate-with-openssl-rand-base64-32>"
NEXTAUTH_DEBUG="true"
AUTH_DANGEROUS_EMAIL_LINKING="false"

# OAuth providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_ID=""
GITHUB_SECRET=""

# Lichess
LICHESS_ENABLED="true"
LICHESS_CLIENT_ID=""
LICHESS_CLIENT_SECRET=""

# Stripe subscriptions
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_PLUS_MONTHLY="price_1TpwDFAq8LJM7jNqxuuzlr4U"
STRIPE_PRICE_PRO_MONTHLY="price_1TpwDGAq8LJM7jNq3ADgqm3H"
BACKRANQ_APP_URL="http://localhost:3000"

# Notifications / email (Resend + Web Push)
RESEND_API_KEY="re_..."
RESEND_WEBHOOK_SECRET="whsec_..."
BACKRANQ_EMAIL_FROM="Backranq <notifications@updates.example.com>"
NOTIFICATION_UNSUBSCRIBE_SECRET="<generate-a-long-random-secret>"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="<web-push-public-key>"
VAPID_PRIVATE_KEY="<web-push-private-key>"
VAPID_SUBJECT="mailto:support@example.com"

# Admin / cron / queues
BACKRANQ_ADMIN_API_SECRET="<generate-a-long-random-secret>"
CRON_SECRET="<generate-a-long-random-secret>"
BACKRANQ_DISABLE_VERCEL_QUEUE="false"
VERCEL_REGION="iad1"
BACKRANQ_LOAD_TEST="false"
